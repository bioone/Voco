{
  "name": "qwen-speech-studio",
  "version": "1.0.0",
  "private": true,
  "description": "本地语音合成与转写工作台",
  "main": "src/electron/main.cjs",
  "type": "module",
  "scripts": {
    "start": "npm run build && electron .",
    "dev": "node scripts/dev.cjs",
    "preview": "vite --config vite.config.js --host 127.0.0.1",
    "build": "vite build --config vite.config.js",
    "test": "node --test tests/*.test.cjs",
    "verify": "node scripts/verify.cjs",
    "package:win": "npm run build && node scripts/package-win.cjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "vite": "8.3.2"
  }
}
